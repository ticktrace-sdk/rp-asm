// =============================================================================
// rp2350.repl - minimal Renode platform description for the RP2350 (M33).
//
// This is *not* a full-fidelity model.  Renode upstream ships nothing for
// the RP2350 family; we approximate enough of the bus + UART to validate
// the v0.1 image (boot from SRAM, init UART, print banner, blink LED).
//
// Notable simplifications vs. real silicon:
//   - Single Cortex-M33 core; the RP2350 has two M33 + two Hazard3 RISC-V.
//   - No bootrom; we set VTOR explicitly in the .resc and let the firmware
//     bring up the rest.
//   - Atomic register aliases (+0x1000 XOR / +0x2000 SET / +0x3000 CLR) are
//     covered by sizing each peripheral region at 0x4000 and decoding the
//     alias offset inside the Python peripheral.  Reads of RESET_DONE
//     always return ~RESET so the spin loop in startup.S exits.
//   - PIO0/PIO1/PIO2, DMA, USB, ADC, watchdog, timers (TIMER0/TIMER1) are
//     not modelled; their address windows are present as PythonPeripheral
//     stubs so stray accesses log instead of bus-faulting.
//   - SIO is a flat MappedMemory region; we observe writes via the bus
//     monitor in the .resc rather than modelling the GPIO state machine.
// =============================================================================

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

nvic0: IRQControllers.NVIC @ sysbus 0xe000e000
    -> cpu0@0
    systickFrequency: 12000000

// ----- Memory --------------------------------------------------------------
// 8 x 64K SRAM banks (512K contiguous) + 4 KiB scratch X/Y at 0x20080000.
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000

scratch_x: Memory.MappedMemory @ sysbus 0x20080000
    size: 0x1000

scratch_y: Memory.MappedMemory @ sysbus 0x20081000
    size: 0x1000

// XIP window (16 MiB) for future flash boot - empty backing for now.
xip: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x1000000

// Boot ROM region (32 KiB) - empty.
bootrom: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x8000

// ----- RESETS (with auto-clearing RESET_DONE mirror) -----------------------
// 0x4000 wide so it covers the four atomic alias windows (RW/XOR/SET/CLR).
resets: Python.PythonPeripheral @ sysbus 0x40020000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    state = {'reset': 0xFFFFFFFF}
elif request.IsRead:
    off = request.Offset & 0xFFF
    if off == 0x00:
        request.Value = state['reset']
    elif off == 0x08:
        # RESET_DONE = ~RESET
        request.Value = (~state['reset']) & 0xFFFFFFFF
    else:
        request.Value = 0
elif request.IsWrite:
    off = request.Offset
    val = request.Value & 0xFFFFFFFF
    base = off & 0xFFF
    alias = off & 0x3000
    if base == 0x00:
        if alias == 0x0000:
            state['reset'] = val
        elif alias == 0x1000:
            state['reset'] = (state['reset'] ^ val) & 0xFFFFFFFF
        elif alias == 0x2000:
            state['reset'] = (state['reset'] | val) & 0xFFFFFFFF
        elif alias == 0x3000:
            state['reset'] = state['reset'] & ((~val) & 0xFFFFFFFF)
'''

// ----- IO_BANK0 ------------------------------------------------------------
// 30 GPIO * 8B = 0xF0; spans + atomic aliases up to 0x4000.  Stub: drop
// writes silently, return 0 on read.
io_bank0: Python.PythonPeripheral @ sysbus 0x40028000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// ----- PADS_BANK0 ----------------------------------------------------------
pads_bank0: Python.PythonPeripheral @ sysbus 0x40038000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// ----- UART0 (PL011) -------------------------------------------------------
uart0: UART.PL011 @ sysbus 0x40070000
    -> nvic0@33

uart1: UART.PL011 @ sysbus 0x40078000
    -> nvic0@34

// ----- TIMER0 / TIMER1 (stub) ---------------------------------------------
// Renode doesn't ship an RP2350-compatible timer.  We expose a freerunning
// 32-bit counter at TIMERAWL so the firmware can poll if needed.  Used in
// M2+ when we add tick-based delay routines.
timer0: Python.PythonPeripheral @ sysbus 0x400b0000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    counter = [0]
elif request.IsRead:
    off = request.Offset & 0xFFF
    if off == 0x28:
        counter[0] = (counter[0] + 1) & 0xFFFFFFFF
        request.Value = counter[0]
    else:
        request.Value = 0
'''

timer1: Python.PythonPeripheral @ sysbus 0x400b8000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// ----- PIO0 / PIO1 / PIO2 (stub) -------------------------------------------
pio0: Python.PythonPeripheral @ sysbus 0x50200000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

pio1: Python.PythonPeripheral @ sysbus 0x50300000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

pio2: Python.PythonPeripheral @ sysbus 0x50400000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// ----- SIO (M33-local single-cycle IO) -------------------------------------
// On real silicon SIO is per-core and not bus-visible from other masters.
// Renode's CortexM happily routes 0xD0000000 through sysbus, so we put a
// 64K MappedMemory there: writes land, the .resc bus monitor watches the
// XOR alias for LED toggles.
sio: Memory.MappedMemory @ sysbus 0xd0000000
    size: 0x10000

// ----- M2 clock-tree peripherals -------------------------------------------
// These are minimum-fidelity stubs that auto-assert STABLE / LOCK / SELECTED
// on the first relevant write so the firmware progresses past its spin
// loops.  None of them model the actual frequency tree - that's T4 territory.

// XOSC: read of STATUS returns STABLE (bit 31) once CTRL has been written.
xosc: Python.PythonPeripheral @ sysbus 0x40048000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    state = {'enabled': False}
elif request.IsRead:
    off = request.Offset & 0xFFF
    if off == 0x04:    # STATUS
        request.Value = 0x80000000 if state['enabled'] else 0
    else:
        request.Value = 0
elif request.IsWrite:
    off = request.Offset & 0xFFF
    if off == 0x00:    # CTRL
        state['enabled'] = True
'''

// PLL_SYS: CS read returns LOCK (bit 31) once PWR has been written.
pll_sys: Python.PythonPeripheral @ sysbus 0x40050000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    state = {'cs': 0, 'pwr_written': False}
elif request.IsRead:
    off = request.Offset & 0xFFF
    if off == 0x00:
        v = state['cs']
        if state['pwr_written']:
            v |= 0x80000000
        request.Value = v
    else:
        request.Value = 0
elif request.IsWrite:
    off = request.Offset & 0xFFF
    if off == 0x00:
        state['cs'] = request.Value & 0x3F
    elif off == 0x04:
        state['pwr_written'] = True
'''

pll_usb: Python.PythonPeripheral @ sysbus 0x40058000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    state = {'cs': 0, 'pwr_written': False}
elif request.IsRead:
    off = request.Offset & 0xFFF
    if off == 0x00:
        v = state['cs']
        if state['pwr_written']:
            v |= 0x80000000
        request.Value = v
    else:
        request.Value = 0
elif request.IsWrite:
    off = request.Offset & 0xFFF
    if off == 0x00:
        state['cs'] = request.Value & 0x3F
    elif off == 0x04:
        state['pwr_written'] = True
'''

// CLOCKS: per-clock SELECTED returns 1 << SRC of the most recent CTRL write.
//   Per-clock layout: CTRL @ +0, DIV @ +4, SELECTED @ +8, stride 12 (0x0C).
//   Sub-blocks we care about: CLK_REF @ 0x30, CLK_SYS @ 0x3C, CLK_PERI @ 0x48.
clocks: Python.PythonPeripheral @ sysbus 0x40010000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    selected = {}     # block_off -> SELECTED value
elif request.IsRead:
    off = request.Offset & 0xFFF
    blk = off - (off % 0x0C)
    sub = off % 0x0C
    if sub == 0x08:
        request.Value = selected.get(blk, 1)
    else:
        request.Value = 0
elif request.IsWrite:
    off = request.Offset & 0xFFF
    base = off & 0xFFF
    blk = base - (base % 0x0C)
    sub = base % 0x0C
    if sub == 0x00:    # CTRL
        # Use SRC field width = 2 for CLK_REF (blk 0x30), else 1.
        # SYS / PERI / USB / ADC use SRC[0] = AUX vs primary; REF uses SRC[1:0].
        if blk == 0x30:
            src = request.Value & 0x3
        else:
            src = request.Value & 0x1
        selected[blk] = 1 << src
'''

// WATCHDOG: dumb sink, returns 0.
watchdog: Python.PythonPeripheral @ sysbus 0x400d8000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// POWMAN: dumb sink (we don't actually program anything in M2).
// Sized to 0x4000 so it doesn't overlap TICKS at 0x40108000.
powman: Python.PythonPeripheral @ sysbus 0x40100000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// TICKS: dumb sink.
ticks: Python.PythonPeripheral @ sysbus 0x40108000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    pass
elif request.IsRead:
    request.Value = 0
'''

// ===== DMA (M3-C) ==========================================================
// Functional model: per-channel READ_ADDR/WRITE_ADDR/TRANS_COUNT/CTRL +
// the four global registers we touch (MULTI_CHAN_TRIGGER, CHAN_ABORT,
// SNIFF_CTRL, SNIFF_DATA, INTR/INTE0..3).  When the firmware writes a
// triggering alias we synchronously copy (count * data_size) bytes from
// READ_ADDR to WRITE_ADDR via the SystemBus.
//
// Sized at 0x10000 to cover per-channel block (16 ch * 0x40 = 0x400),
// global regs around 0x400..0x44C, debug aliases at 0x800+, and the four
// atomic alias windows up to 0x4000.  We use 0x10000 to be safe.
dma: Python.PythonPeripheral @ sysbus 0x50000000
    size: 0x10000
    initable: true
    script: '''
if request.IsInit:
    # Per-channel state: 16 dicts of { read, write, count, ctrl }
    chan = [{"read": 0, "write": 0, "count": 0, "ctrl": 0} for _ in range(16)]
    # Global sniffer state (CRC32 not modelled; we just hold a register)
    sniff = {"ctrl": 0, "data": 0}
    # IRQ state (W1C INTR)
    irq = {"intr": 0, "inte": [0, 0, 0, 0]}
    # Resolve a SystemBus reference for the synchronous copy.  PythonPeripheral
    # doesn't expose Machine; we go via the EmulationManager singleton and
    # pick the (single) machine in this emulation.
    from Antmicro.Renode.Core import EmulationManager
    _emu = EmulationManager.Instance.CurrentEmulation
    _bus = list(_emu.Machines)[0].SystemBus
elif request.IsRead:
    off = request.Offset & 0xFFFF
    base = off & 0xFFF
    # Per-channel block
    if base < 0x400:
        ch = base // 0x40
        sub = base % 0x40
        # CTRL_TRIG / AL1_CTRL / AL2_CTRL / AL3_CTRL all read CTRL value.
        # BUSY (bit 26) is always 0 since the copy completes synchronously
        # at trigger time.
        if sub in (0x0C, 0x10, 0x20, 0x30):
            request.Value = chan[ch]["ctrl"] & ~(1 << 26)
        elif sub == 0x00:
            request.Value = chan[ch]["read"]
        elif sub == 0x04:
            request.Value = chan[ch]["write"]
        elif sub == 0x08:
            request.Value = chan[ch]["count"]
        else:
            request.Value = 0
    elif base == 0x400:
        request.Value = irq["intr"]
    elif base in (0x404, 0x414, 0x424, 0x434):
        request.Value = irq["inte"][(base - 0x404) // 0x10]
    elif base == 0x434:
        request.Value = sniff["ctrl"]
    elif base == 0x438:
        request.Value = sniff["data"]
    elif base == 0x444:
        # CHAN_ABORT auto-clears: no channel is ever actually busy in our
        # model so abort completes instantly.
        request.Value = 0
    elif base == 0x448:
        request.Value = 16            # N_CHANNELS
    else:
        request.Value = 0
elif request.IsWrite:
    off = request.Offset & 0xFFFF
    base = off & 0xFFF
    val = request.Value & 0xFFFFFFFF
    # Per-channel block
    if base < 0x400:
        ch = base // 0x40
        sub = base % 0x40
        c = chan[ch]
        # Update the right shadow register
        if sub in (0x00, 0x14, 0x28, 0x3C):           # READ_ADDR / aliases
            c["read"] = val
        elif sub in (0x04, 0x18, 0x34, 0x2C):         # WRITE_ADDR / aliases
            c["write"] = val
        elif sub in (0x08, 0x1C, 0x24, 0x38):         # TRANS_COUNT / aliases
            c["count"] = val
        elif sub in (0x0C, 0x10, 0x20, 0x30):         # CTRL / aliases
            c["ctrl"] = val
        # Triggering offsets: 0x0C, 0x1C, 0x2C, 0x3C
        if sub in (0x0C, 0x1C, 0x2C, 0x3C):
            ds = (c["ctrl"] >> 2) & 0x3
            elt = {0: 1, 1: 2, 2: 4}.get(ds, 1)
            n = c["count"] * elt
            if n > 0 and c["read"] != 0 and c["write"] != 0:
                # Synchronous copy via SystemBus.
                src = c["read"]
                dst = c["write"]
                for i in range(n):
                    b = _bus.ReadByte(src + i)
                    _bus.WriteByte(dst + i, b)
            # Latch interrupt for this channel (if not IRQ_QUIET)
            if not (c["ctrl"] & (1 << 23)):
                irq["intr"] |= (1 << ch)
    elif base == 0x400:
        # W1C
        irq["intr"] &= ~val
    elif base in (0x404, 0x414, 0x424, 0x434):
        irq["inte"][(base - 0x404) // 0x10] = val
    elif base == 0x430:
        # MULTI_CHAN_TRIGGER: write 1<<n to trigger channel n
        for ch in range(16):
            if val & (1 << ch):
                c = chan[ch]
                ds = (c["ctrl"] >> 2) & 0x3
                elt = {0: 1, 1: 2, 2: 4}.get(ds, 1)
                n = c["count"] * elt
                if n > 0 and c["read"] != 0 and c["write"] != 0:
                    src = c["read"]
                    dst = c["write"]
                    for i in range(n):
                        b = _bus.ReadByte(src + i)
                        _bus.WriteByte(dst + i, b)
                if not (c["ctrl"] & (1 << 23)):
                    irq["intr"] |= (1 << ch)
    elif base == 0x434:
        sniff["ctrl"] = val
    elif base == 0x438:
        sniff["data"] = val
    elif base == 0x444:
        # CHAN_ABORT - no-op (everything is "already finished" in our model)
        pass
'''
// ===== END DMA =============================================================
